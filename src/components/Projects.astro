---
import { work } from "@/cv.json";
import SectionContainer from "@components/SectionContainer.astro";
import SectionTitle from "@components/SectionTitle.astro";
import Briefcase from "@components/icons/Briefcase.astro";
import BentoCard from "@components/BentoCard.astro";
import BadgeTech from "@components/BadgeTech.astro";
import Tailwind from "@components/icons/Tailwind.astro";
import Angular from "@components/icons/Angular.astro";
import Contentful from "@components/icons/Contentful.astro";
import ButtonLink from "@components/ButtonLink.astro";
import Wordpress from "@components/icons/Wordpress.astro";
import Appsmith from "./icons/Appsmith.astro";
---

<SectionContainer id="proyectos">
  <SectionTitle title="Proyectos">
    <Briefcase class="size-8 text-slate-900 dark:text-slate-300" slot="icon-left" />
  </SectionTitle>
  <div class="relative mt-4 w-full grid grid-cols-10 gap-4">
    <BentoCard
      title="Desarrollo del sitio recargas electrónicas"
      class="flex flex-col lg:flex-row col-span-10"
    >
      <div
        slot="image"
        class="shrink-0 order-2 lg:order-1 w-full lg:w-100 aspect-3/2 rounded-2xl overflow-hidden mx-auto
           bg-cover bg-center bg-no-repeat opacity-80 bg-blend-luminosity bg-[url('/src/assets/recarga5g.webp')]
          mask-b-from-85% mask-b-to-100%"
      >
      </div>

      <div slot="content" class="flex-1 text-base">
        <div class="icons grid grid-cols-[repeat(auto-fit,minmax(120px,1fr))] gap-4">
          <BadgeTech label="Tailwind">
            <Tailwind slot="icon-left" />
          </BadgeTech>

          <BadgeTech label="Angular">
            <Angular slot="icon-left" />
          </BadgeTech>

          <BadgeTech label="Contentful">
            <Contentful slot="icon-left" />
          </BadgeTech>
        </div>

        <p class="font-mono py-4 text-slate-600 dark:text-slate-400">
          pagina corporativa 2da version para el sitio web oficial
          recargas.electrónicas
        </p>

        <ButtonLink href="https://recarga5g.com/" label="Consultar" />
      </div>
    </BentoCard>
   
    <BentoCard
    title="Desarrollo 1ver version corporativo Servitae"
    class="flex flex-col lg:flex-row col-span-10"
  >
      
 
      <div slot="image" class="h-52 shrink-0 order-2 lg:order-1 relative w-full lg:w-100 aspect-3/2 rounded-2xl overflow-hidden mx-auto bg-slate-100 dark:bg-slate-900 border  border-slate-200 dark:border-slate-700/50 p-6 flex items-center justify-center">
        <div class="absolute inset-0 opacity-10 bg-[url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSIyMCIgaGVpZ2h0PSIyMCI+PGNpcmNsZSBjeD0iMTAiIGN5PSIxMCIgcj0iMiIgZmlsbD0iIzYzNjZmMSIvPjwvc3ZnPg==')]" />
        <div class="flex gap-4 items-center">
          <Wordpress class="size-32" />
          <span class="text-2xl font-bold text-slate-700 dark:text-white text-center">Wordpress</span>
        </div>
      </div>
  

    <div slot="content" class="flex-1 text-base">
        <BadgeTech label="Wordpress">
          <Wordpress slot="icon-left" class="size-4" />
        </BadgeTech>

  
      <p class="font-mono py-4 text-slate-600 dark:text-slate-400">
        pagina corporativa 2da version para el sitio web oficial
        recargas.electrónicas
      </p>

    </div>
  </BentoCard>

  <BentoCard
  title="Diseño y elaboracion sistema gestion multicanal"
  class="flex flex-col lg:flex-row col-span-10"
>

<div slot="image" class="h-52 shrink-0 order-2 lg:order-1 relative w-full lg:w-100 aspect-3/2 rounded-2xl overflow-hidden mx-auto bg-slate-100 dark:bg-slate-900 border  border-slate-200 dark:border-slate-700/50 p-6 flex items-center justify-center">
  <div class="absolute inset-0 opacity-10 bg-[url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSIyMCIgaGVpZ2h0PSIyMCI+PGNpcmNsZSBjeD0iMTAiIGN5PSIxMCIgcj0iMiIgZmlsbD0iIzYzNjZmMSIvPjwvc3ZnPg==')]" />
  <div class="flex gap-4 items-center">
    <Appsmith class="size-32" />
    <span class="text-2xl font-bold text-slate-700 dark:text-white text-center">Appsmith</span>
  </div>
</div>

  <div slot="content" class="flex-1 text-base">
    <div class="icons grid grid-cols-[repeat(auto-fit,minmax(120px,1fr))] gap-4">
      <BadgeTech label="Appsmith">
        <Appsmith slot="icon-left" class="size-4" />
      </BadgeTech>

      <BadgeTech label="Appsmith">
        <Appsmith slot="icon-left" class="size-4" />
      </BadgeTech>

      <BadgeTech label="Appsmith">
        <Appsmith slot="icon-left" class="size-4" />
      </BadgeTech>


    </div>

    <p class="font-mono py-4 text-slate-600 dark:text-slate-400">
      pagina corporativa 2da version para el sitio web oficial
      recargas.electrónicas
    </p>

    <ButtonLink href="https://recarga5g.com/" label="Consultar" />
  </div>
</BentoCard>
 
  
  </div>
</SectionContainer>
