---
import ThemeToggle from "@components/ThemeToggle.astro";
import  Navbar from "@components/NavBar.astro";

---

<header
  class="fixed lg:backdrop-blur-md lg:bg-white/30 lg:dark:bg-slate-700/10 top-0 left-0 w-full z-50 transition-all duration-700
  ease-[cubic-bezier(0.23,1,0.32,1)]"
>
  <div
    class="max-w-6xl relative h-16 mx-auto px-4 sm:px-6 lg:px-8
 flex flex-wrap items-center justify-between"
  >
  <div
  aria-hidden="true"
  class="absolute lg:hidden inset-x-0 top-0 h-16 -z-10 backdrop-blur-md bg-white/30 dark:bg-slate-700/10"
></div>
    <div class="logo shrink-0 order-1">
      <a
        class="font-bold text-xl flex items-center gap-x-4 text-indigo-500"
        href="#home"
      >
        <svg
          class="size-6"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
        </svg>
        <span class="font-mono tracking-tight">JonyDevp</span>
      </a>
    </div>

      <Navbar />
    <div
      class="theme flex items-center gap-x-4 lg:block order-2 lg:order-3 shrink-0 p-2 rounded-lg relative"
    >
      <ThemeToggle />

      <button type="button" id="toggle-nav" class="p-2 block cursor-pointer lg:hidden">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-width="1.5" class="size-6" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M12 17.25h8.25"/></svg>
      </button>
    </div>
  </div>
</header>

<script>
  let abortController: AbortController | null = null;
  let observer: IntersectionObserver | null = null;

  document.addEventListener("astro:page-load", () => {
    abortController?.abort();
    observer?.disconnect();
    abortController = new AbortController();
    const { signal } = abortController;

    const nav = document.getElementById("navbar");
    const toggle = document.getElementById("toggle-nav");
    if (!nav || !toggle) return;

    // --- Menú móvil ---
    const setOpen = (open: boolean) => {
      nav.dataset.open = String(open);
      toggle.setAttribute("aria-expanded", String(open));
    };

    toggle.addEventListener(
      "click",
      (e) => {
        e.stopPropagation();
        setOpen(nav.dataset.open !== "true");
      },
      { signal },
    );

    document.addEventListener(
      "click",
      (e) => {
        if (!nav.contains(e.target as Node)) setOpen(false);
      },
      { signal },
    );

    nav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setOpen(false), { signal });
    });

    // --- Resaltado del link activo ---
    const navItems = nav.querySelectorAll<HTMLAnchorElement>("a");
    const sections = document.querySelectorAll("section");

    const obs = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          navItems.forEach((item) => {
            const active = item.getAttribute("aria-label") === entry.target.id;
            item.classList.toggle("text-white", active);
            item.classList.toggle("bg-slate-800", active);
            item.classList.toggle("text-slate-700", !active);
          });
        });
      },
      { root: null, rootMargin: "0px", threshold: 0.3 },
    );
    observer = obs;
    sections.forEach((section) => obs.observe(section));

    document.addEventListener(
      "visibilitychange",
      () => {
        if (document.visibilityState === "hidden") {
          obs.disconnect();
        } else {
          sections.forEach((section) => obs.observe(section));
        }
      },
      { signal },
    );
  });
</script>
