---
const { label, class: className } = Astro.props;
---

<span class={`inline-flex items-center justify-center gap-1.5 py-1.5 px-4 rounded-md text-sm bg-gray-100 shadow text-blue-700 dark:bg-blue-900/20 dark:text-white ${className || ''}`}>
    <slot name="icon-left" />
    <span>{label}</span>
    <slot name="icon-right" />
</span>