---
interface Props {
  title: string;
  class?: string;
}

const { title } = Astro.props;
---

<article
  class={`relative overflow-hidden rounded-xl backdrop-blur-xl border border-slate-200/50 dark:border-slate-700/50 p-4 shadow-sm col-span-10 group group-hover:shadow-lg ${Astro.props.class}`}
>

  <!-- image -->
  <slot name="image" />

  <div class="relative z-20 flex h-full flex-col justify-end gap-1 p-4 text-lg order-1 lg:order-2">    
    <header class="mb-4">
      <h3
        class="font-bold text-2xl text-slate-800 dark:text-white leading-tight mb-1">
        {title}
      </h3>
    </header>
    <slot name="content"></slot>
  </div>
</article>
