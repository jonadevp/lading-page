---
interface Props {
  title: string;
}

const {title} = Astro.props;
---
<div class="inline-flex items-center gap-x-2 rounded-lg shadow-sm text-sm py-1 px-3 bg-emerald-50 dark:bg-emerald-900/30">
    <span class="relative flex size-2.5">
        <span class="animate-ping absolute inline-flex size-full rounded-full bg-emerald-500 opacity-75"/>
        <span class="relative inline-flex rounded-full size-2.5 bg-emerald-500" />
    </span>
    <span class="font-medium font-mono text-emerald-700 dark:text-emerald-300 tracking-wider">{title}</span>
</div>